# microCMSの管理画面 > サービス設定 > API キー から取得
MICROCMS_SERVICE_DOMAIN=your-service
MICROCMS_API_KEY=your-api-key

# Umami Cloud (https://cloud.umami.is) にサイトを登録すると発行される Website ID
# 「Websites」>対象サイト>「Tracking code」の data-website-id の値をそのまま貼り付ける
# 未設定でもビルド・表示は壊れない(トラッキングスクリプトが挿入されないだけ)
UMAMI_WEBSITE_ID=your-umami-website-id
