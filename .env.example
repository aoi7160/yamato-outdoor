# microCMSのサービスID。管理画面URL https://XXXX.microcms.io の XXXX 部分。
# サイトの独自ドメイン(yamato-outdoor.com)とは別物。「.microcms.io」は付けない。
MICROCMS_SERVICE_DOMAIN=yamato-outdoor

# microCMS管理画面 > サービス設定 > APIキー で発行したキー。
# GET と GET(下書き) だけを有効にした読み取り専用キーを使う。絶対にコミットしない。
MICROCMS_API_KEY=your-api-key

# ------------------------------------------------------------------
# 計測タグ。**すべて任意。空(未設定)ならそのタグは1バイトも出力されない。**
# 設定手順と各ツールの役割は docs/analytics.md を参照。
# Cloudflare Pagesでは Production にだけ入れると、PRプレビューの
# アクセスが本番の数字に混ざらない。
# ------------------------------------------------------------------

# Googleタグマネージャー。これを入れるとGA4もGTM側から配信する(推奨)
GTM_ID=

# GA4の測定ID。GTMを使わずGA4だけ入れたいときに設定する(GTM_IDが空のときだけ使われる)
GA4_ID=

# Microsoft Clarity(無料のヒートマップ・セッション録画)のプロジェクトID
CLARITY_ID=

# Search Consoleの所有権確認メタタグの値。DNS(TXT)で確認するなら空でよい
GSC_VERIFICATION=

# 将来の広告配信に向けてオーディエンスを貯める場合だけ設定する。
# 入れるとプライバシーポリシーの外部送信一覧に自動で追加される。
META_PIXEL_ID=
X_PIXEL_ID=

# '1' にすると、IDが入っていても計測タグを一切出力しない(緊急停止用)
ANALYTICS_DISABLED=
