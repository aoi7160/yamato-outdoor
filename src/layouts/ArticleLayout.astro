---
import BaseLayout from './BaseLayout.astro';
import '../styles/article.css';
import { prepareArticle, formatDate, type TocItem } from '../lib/article';
import SocialIcon from '../components/SocialIcon.astro';
import { SOCIALS, SOCIAL_ORDER } from '../lib/site';

export type FaqItem = { q: string; a: string };
export type RelatedItem = { title: string; href: string; meta?: string };

interface Props {
  title: string;
  description?: string;
  content: string;
  categoryName?: string;
  categorySlug?: string;
  publishedAt?: string;
  revisedAt?: string;
  thumbnailUrl?: string;
  thumbnailCaption?: string;
  tags?: string[];
  faq?: FaqItem[];
  related?: RelatedItem[];
  author?: { name: string; role: string; bio: string };
}

const {
  title,
  description = '',
  content,
  categoryName,
  categorySlug,
  publishedAt,
  revisedAt,
  thumbnailUrl,
  thumbnailCaption,
  tags = [],
  faq = [],
  related = [],
  author = {
    name: '濵地 蒼麗',
    role: 'Founder / Editor',
    bio:
      '会社勤めの傍ら、月1〜2回のペースで山に入る。六甲、金剛山、大山など関西の山を中心に、スタイルを問わず足繁く通う。カタログスペックに頼るのではなく、実際の山行で実測重量や耐候性を自ら確かめることを大切にしている。数々の失敗を経て得た知見をもとに記事を監修し、自身が納得できる道具を追い求めた結果、アウトドアブランド「YAMATO OUTDOOR」の立ち上げに至る。',
  },
} = Astro.props;

const { html, toc, readingMinutes } = prepareArticle(content);

const published = formatDate(publishedAt);
const revised = formatDate(revisedAt);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

// シェア先。Instagram / TikTok にはWebからの共有導線が無いので、
// ここには置かず、フォロー用リンクとして別に並べている。
const shareTargets = {
  x: `https://x.com/intent/post?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonical)}`,
  threads: `https://www.threads.net/intent/post?text=${encodeURIComponent(`${title} ${canonical}`)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`,
} as const;

const labels: Record<string, string> = { x: 'X', threads: 'Threads', facebook: 'Facebook' };

// フォロー欄と同じ並び順で出す。LINEは共有専用なので最後に足す。
const shares = SOCIAL_ORDER.filter((name): name is keyof typeof shareTargets => name in shareTargets)
  .map((name) => ({ name, label: labels[name], href: shareTargets[name] }))
  .concat([
    {
      name: 'line' as never,
      label: 'LINE',
      href: `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(canonical)}`,
    },
  ]);

const follows = SOCIAL_ORDER.map((name) => SOCIALS.find((s) => s.name === name)).filter(
  (s): s is (typeof SOCIALS)[number] => Boolean(s?.href),
);

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: publishedAt,
    dateModified: revisedAt ?? publishedAt,
    image: thumbnailUrl ? [thumbnailUrl] : undefined,
    author: { '@type': 'Person', name: author.name },
    publisher: { '@type': 'Organization', name: 'YAMATO OUTDOOR' },
    mainEntityOfPage: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TOP', item: Astro.site?.href ?? '/' },
      categoryName
        ? { '@type': 'ListItem', position: 2, name: categoryName }
        : undefined,
      { '@type': 'ListItem', position: categoryName ? 3 : 2, name: title, item: canonical },
    ].filter(Boolean),
  },
];

if (faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

// 目次に出すのはh2のみ。h3まで並べると項目が増えすぎて一覧性が落ちる。
const tocItems: TocItem[] = toc.filter((item) => item.level === 2);
---

<BaseLayout title={`${title} | YAMATO OUTDOOR`} description={description} ogImage={thumbnailUrl} ogType="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </Fragment>

  <div class="read-progress" id="readProgress" aria-hidden="true"></div>

  {follows.length > 0 && (
    <aside class="follow-rail" aria-label="公式SNS">
      <span class="follow-rail__label">Follow</span>
      <span class="follow-rail__line" aria-hidden="true"></span>
      <ul>
        {follows.map((item) => (
          <li>
            <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label} title={item.label}>
              <SocialIcon name={item.name} />
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )}

  <article class="article-page">
    <div class="shell">
      <header class="article-head">
        <ol class="breadcrumb">
          <li><a href="/">TOP</a></li>
          {categoryName && (
            <li>{categorySlug ? <a href={`/category/${categorySlug}`}>{categoryName}</a> : categoryName}</li>
          )}
          <li aria-current="page">この記事</li>
        </ol>

        <div class="article-labels">
          {categoryName && <span class="label-category">{categoryName}</span>}
        </div>

        <h1 class="article-title">{title}</h1>

        {description && <p class="article-lead">{description}</p>}

        <dl class="article-meta">
          {published && (
            <div><dt>Published</dt><dd><time datetime={publishedAt}>{published}</time></dd></div>
          )}
          {revised && revised !== published && (
            <div><dt>Updated</dt><dd><time datetime={revisedAt}>{revised}</time></dd></div>
          )}
          <div><dt>Read</dt><dd>{readingMinutes} min</dd></div>
          {categoryName && <div><dt>Category</dt><dd>{categoryName}</dd></div>}
        </dl>
      </header>

      {thumbnailUrl && (
        <figure class="article-figure">
          <img src={thumbnailUrl} alt={title} width="1600" height="900" />
          {thumbnailCaption && <figcaption>{thumbnailCaption}</figcaption>}
        </figure>
      )}

      <div class="article-grid">
        <div>
          {tocItems.length > 1 && (
            <nav class="toc toc--inline" aria-label="目次">
              <p class="toc__title">Contents</p>
              <p class="toc__sub">この記事の目次</p>
              <ol>
                {tocItems.map((item) => (
                  <li><a href={`#${item.id}`}>{item.text}</a></li>
                ))}
              </ol>
            </nav>
          )}

          <div class="prose" set:html={html} />

          {faq.length > 0 && (
            <section class="faq" aria-labelledby="faq-heading">
              <h2 class="faq__heading" id="faq-heading">よくある質問</h2>
              {faq.map((item, i) => (
                <details open={i === 0}>
                  <summary>{item.q}</summary>
                  <div class="faq__answer"><p>{item.a}</p></div>
                </details>
              ))}
            </section>
          )}

          <aside class="author">
            <p class="author__label">Author</p>
            <div>
              <p class="author__role">{author.role}</p>
              <p class="author__name">{author.name}</p>
              <p class="author__bio">{author.bio}</p>
            </div>
          </aside>

          <div class="article-tail">
            {tags.length > 0 && (
              <ul class="tag-list">
                {tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
            <div class="share">
              <span class="share__label">Share</span>
              <ul class="social social--share">
                {shares.map((item) => (
                  <li>
                    <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.label}でシェア`} title={item.label}>
                      <SocialIcon name={item.name} />
                    </a>
                  </li>
                ))}
                <li>
                  <button type="button" class="share__copy" id="copyLink" aria-label="リンクをコピー" title="リンクをコピー">
                    <span aria-hidden="true">⧉</span>
                  </button>
                </li>
              </ul>
            </div>

          </div>
        </div>

        {tocItems.length > 1 && (
          <nav class="toc toc--aside" aria-label="目次(追従)" id="tocAside">
            <p class="toc__title">Contents</p>
            <p class="toc__sub">読んでいる位置</p>
            <ol>
              {tocItems.map((item) => (
                <li><a href={`#${item.id}`}>{item.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
      </div>

      {related.length > 0 && (
        <section class="related" aria-labelledby="related-heading">
          <div class="related__head">
            <h2 class="related__heading" id="related-heading">Related reading</h2>
            <a class="related__all" href="/">View all</a>
          </div>
          <ol class="related__list">
            {related.map((item) => (
              <li>
                <a href={item.href}>
                  <h3>{item.title}</h3>
                  <span class="card-meta">{item.meta ?? ''}</span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>
  </article>

  <a href="#" class="to-top" id="toTop" aria-label="ページ上部へ戻る">↑</a>

  <script is:inline>
    (() => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // --- 読了プログレスと「上に戻る」ボタン ---
      const bar = document.getElementById('readProgress');
      const toTop = document.getElementById('toTop');
      const article = document.querySelector('.article-page');

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          if (bar && article) {
            const start = article.offsetTop;
            const total = article.offsetHeight - window.innerHeight;
            const passed = window.scrollY - start;
            const ratio = total > 0 ? Math.min(Math.max(passed / total, 0), 1) : 0;
            bar.style.width = (ratio * 100).toFixed(2) + '%';
          }
          if (toTop) toTop.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.8);
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      if (toTop) {
        toTop.addEventListener('click', (e) => {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
      }

      // --- リンクのコピー ---
      const copy = document.getElementById('copyLink');
      if (copy && navigator.clipboard) {
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(location.href);
            copy.classList.add('is-done');
            setTimeout(() => copy.classList.remove('is-done'), 1600);
          } catch {
            /* クリップボードが使えない環境では何もしない */
          }
        });
      }

      // --- 追従目次の現在地表示 ---
      const aside = document.getElementById('tocAside');
      const headings = Array.from(document.querySelectorAll('.prose h2[id]'));
      if (aside && headings.length) {
        const links = new Map();
        aside.querySelectorAll('a[href^="#"]').forEach((a) => {
          links.set(decodeURIComponent(a.getAttribute('href').slice(1)), a);
        });
        const mark = (id) => {
          links.forEach((a, key) => a.classList.toggle('is-current', key === id));
        };
        const seen = new Set();
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) seen.add(entry.target.id);
              else seen.delete(entry.target.id);
            });
            const current = headings.find((h) => seen.has(h.id));
            if (current) mark(current.id);
          },
          { rootMargin: '-15% 0px -70% 0px', threshold: 0 },
        );
        headings.forEach((h) => observer.observe(h));
      }

      // --- 霧が晴れるように要素を出す ---
      if (!reduce) {
        const targets = document.querySelectorAll('.prose h2, .prose figure, .article-figure, .faq, .author, .related, .toc--inline');
        targets.forEach((el) => el.classList.add('fade-up'));
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              obs.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      }
    })();
  </script>
</BaseLayout>
