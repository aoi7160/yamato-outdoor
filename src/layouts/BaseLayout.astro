---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { SOCIALS, socialLink } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  /** 検索結果に載せたくないページ(準備中の案内など)で true にする */
  noindex?: boolean;
}

const {
  title,
  description = '山と生きる。山と挑む。実体験ベースのアウトドアメディア。',
  ogImage,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080b10" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- 和文見出し=Zen Old Mincho / 本文=Zen Kaku Gothic New / 欧文=Barlow Condensed。
         和文フォントは重いのでウェイトを1つずつに絞り、読み込みも描画をブロックしない形にする
         (フォント到着前は端末のフォントで表示され、届いた時点で差し替わる)。 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@400&family=Zen+Kaku+Gothic+New:wght@400&family=Barlow+Condensed:wght@400;500&display=swap"
      onload="this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@400&family=Zen+Kaku+Gothic+New:wght@400&family=Barlow+Condensed:wght@400;500&display=swap"
      />
    </noscript>
    <slot name="head" />
  </head>
  <body>
    <!--
      霧の山。画像アセット(写真)は使わず、SVGのシルエットで描いている。
      背景は public/scenery.svg に切り出して背景画像として1枚に焼いている。
      SVGのぼかしフィルタ(feGaussianBlur)をアニメーションさせるとスクロールのたびに
      再計算が走り、実測で5fpsまで落ちたため、ぼかしはグラデーションで代替している。
    -->
    <div class="scenery" aria-hidden="true">
      <div class="scenery__drift"></div>
    </div>

    <header class="site-header">
      <div class="shell">
        <a href="/" class="logo" aria-label="YAMATO OUTDOOR トップへ">
          <Logo class="logo__mark" />
        </a>
        <nav class="site-nav" aria-label="メインメニュー">
          <a href="/mountain-climbing/">登山</a>
          <a href="/fishing/">釣り</a>
          <a href="/camp/">キャンプ</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <div class="footer-brand">
          <Logo class="logo__mark" />
        </div>
        <nav class="footer-nav" aria-label="フッターメニュー">
          <a href="/mountain-climbing/">登山</a>
          <a href="/fishing/">釣り</a>
          <a href="/camp/">キャンプ</a>
          <a href="/about">About</a>
        </nav>
        <ul class="social" aria-label="公式SNS">
          {SOCIALS.map((s) => socialLink(s)).map((link, i) => (
            <li>
              <a
                href={link.href}
                target={link.target}
                rel={link.rel}
                aria-label={link.label}
                title={link.label}
                class={link.pending ? 'is-pending' : ''}
              >
                <SocialIcon name={SOCIALS[i].name} />
              </a>
            </li>
          ))}
        </ul>
        <p class="footer-copy">&copy; {year} YAMATO OUTDOOR</p>
      </div>
    </footer>
  </body>
</html>
