---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { SOCIALS, socialLink, SHOP_URL } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  /** 検索結果に載せたくないページ(準備中の案内など)で true にする */
  noindex?: boolean;
  /** トップページ限定の演出。背景に粒子(グレイン)が漂うレイヤーを1枚足す。
      レイヤーが増えるほど重くなるので、全ページには付けない。 */
  grainDrift?: boolean;
  /** 背景の山と暗幕を外す。Aboutのように、点のグリッドを敷くページで使う
      (山のシルエットと点が重なると、どちらも読み取れなくなるため)。 */
  plain?: boolean;
}

const {
  title,
  description = '山と生きる。山と挑む。実体験ベースのアウトドアメディア。',
  ogImage,
  ogType = 'website',
  noindex = false,
  grainDrift = false,
  plain = false,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080b10" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- 和文見出し=Zen Old Mincho / 本文=Zen Kaku Gothic New / 欧文=Schibsted Grotesk。
         和文フォントは重いのでウェイトを1つずつに絞り、読み込みも描画をブロックしない形にする
         (フォント到着前は端末のフォントで表示され、届いた時点で差し替わる)。 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@400&family=Zen+Kaku+Gothic+New:wght@400&family=Schibsted+Grotesk:wght@400;500&display=swap"
      onload="this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@400&family=Zen+Kaku+Gothic+New:wght@400&family=Schibsted+Grotesk:wght@400;500&display=swap"
      />
    </noscript>
    <slot name="head" />
  </head>
  <body class={plain ? 'is-plain' : undefined}>
    <!--
      霧の山。画像アセット(写真)は使わず、SVGのシルエットで描いている。
      背景は public/scenery.svg に切り出して背景画像として1枚に焼いている。
      SVGのぼかしフィルタ(feGaussianBlur)をアニメーションさせるとスクロールのたびに
      再計算が走り、実測で5fpsまで落ちたため、ぼかしはグラデーションで代替している。
    -->
    {!plain && (
      <div class="scenery" aria-hidden="true">
        <div class="scenery__drift drift--1"></div>
        <div class="scenery__drift drift--2"></div>
        <div class="scenery__drift drift--3"></div>
      </div>
    )}

    <!-- グレイン層は.sceneryの外に出している。body::beforeの暗幕(z-index:-1)が
         .scenery(z-index:-2)を覆っているため、中に置くと不透明度を上げても
         暗幕の下に沈んで見えなくなる。 -->
    {grainDrift && <div class="scenery__grain-drift" aria-hidden="true"></div>}

    <header class="site-header">
      <div class="shell">
        <a href="/" class="logo" aria-label="YAMATO OUTDOOR トップへ">
          <Logo class="logo__mark" />
        </a>
        <div class="site-header__right">
          <nav class="site-nav" aria-label="メインメニュー">
            <a href="/mountain-climbing/">登山</a>
            <a href="/fishing/">釣り</a>
            <a href="/camp/">キャンプ</a>
            <a href="/about">About</a>
          </nav>
          <!-- カートのアイコン。狭い画面では.site-navの3つ目以降(キャンプ/About)を
               隠して2項目だけにしているため、テキストの新しいナビ項目は増やさず、
               .site-navの外に置いた丸いアイコンにして常に表示させている。 -->
          {SHOP_URL && (
            <a
              class="cart-link"
              href={SHOP_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="グッズを見る(SUZURI)"
              title="グッズを見る(SUZURI)"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12L8.1 13h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <div class="footer-brand">
          <Logo class="logo__mark" />
        </div>
        <nav class="footer-nav" aria-label="フッターメニュー">
          <a href="/mountain-climbing/">登山</a>
          <a href="/fishing/">釣り</a>
          <a href="/camp/">キャンプ</a>
          <a href="/about">About</a>
        </nav>
        <ul class="social" aria-label="公式SNS">
          {SOCIALS.map((s) => socialLink(s)).map((link, i) => (
            <li>
              <a
                href={link.href}
                target={link.target}
                rel={link.rel}
                aria-label={link.label}
                title={link.label}
                class={link.pending ? 'is-pending' : ''}
              >
                <SocialIcon name={SOCIALS[i].name} />
              </a>
            </li>
          ))}
        </ul>
        <p class="footer-copy">&copy; {year} YAMATO OUTDOOR</p>
      </div>
    </footer>
  </body>
</html>
