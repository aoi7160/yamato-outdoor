---
import '../styles/global.css';
import { categories } from '../lib/categories';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>[];
  /** 'article' = 記事詳細ページ専用のダークテーマ+拡張ヘッダーを使う。それ以外のページには影響しない。 */
  variant?: 'default' | 'article';
  /** variant='article'時、ヘッダーのカテゴリタブでこのslugを選択中として強調する。 */
  activeCategorySlug?: string;
}

const {
  title,
  description = '山と生きる。山と挑む。実体験ベースのアウトドアメディア。',
  jsonLd = [],
  variant = 'default',
  activeCategorySlug,
} = Astro.props;

const isArticleTheme = variant === 'article';

// Umami Cloudの無料Hobbyプランで計測する。UMAMI_WEBSITE_ID未設定時はスクリプトごと省略する
// (アカウント作成前でもビルド・表示が壊れないようにするため)。
const umamiWebsiteId = import.meta.env.UMAMI_WEBSITE_ID;

// サイト全体で常に出す構造化データ(WebSite/Organization)。
// SNS・Wikipedia等のエンティティが無い現状はsameAsを持たせない(実在しないものを捏造しない)。
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://yamato-outdoor.com';
const baseJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'YAMATO OUTDOOR',
    alternateName: '山と生きる。山と挑む。',
    url: siteUrl,
    description: '山と生きる。山と挑む。実体験ベースのアウトドアメディア。',
    inLanguage: 'ja',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'YAMATO OUTDOOR',
    url: siteUrl,
    logo: `${siteUrl}/logo.png`,
  },
];
const allJsonLd = [...baseJsonLd, ...jsonLd];

const marqueeItems = [
  '山と生きる。山と挑む。',
  'YAMATO OUTDOOR',
  '実体験ベースのアウトドアメディア',
  '登山 / 釣り / キャンプ',
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    {umamiWebsiteId && (
      <script defer src="https://cloud.umami.is/script.js" data-website-id={umamiWebsiteId}></script>
    )}
    {allJsonLd.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body class={isArticleTheme ? 'theme-article' : ''}>
    <a href="#main" class="skip-link">本文へスキップ</a>

    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {
          [...marqueeItems, ...marqueeItems].map((item, i) => (
            <span class={i % 4 === 1 ? 'is-accent' : ''}>{item}</span>
          ))
        }
      </div>
    </div>

    <header class="site-header" id="site-header">
      {
        isArticleTheme && (
          <div class="container header-utility-bar">
            <div class="header-social">
              <button type="button" aria-label="Instagram(準備中)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none" />
                </svg>
              </button>
              <button type="button" aria-label="X(準備中)">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M3 3l7.5 8.4L3.4 21H6l6-6.7L17 21h4l-7.9-8.9L20.6 3H18l-5.6 6.2L7 3H3z" />
                </svg>
              </button>
              <button type="button" aria-label="YouTube(準備中)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="2.5" y="6" width="19" height="12" rx="4" />
                  <path d="M10.5 9.5l5 2.5-5 2.5v-5z" fill="currentColor" stroke="none" />
                </svg>
              </button>
            </div>
            <div class="header-actions">
              <button type="button" class="header-pill-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="7" y="2.5" width="10" height="19" rx="2.5" />
                  <path d="M11 18.5h2" stroke-linecap="round" />
                </svg>
                <span>アプリを入手</span>
              </button>
              <button type="button" class="header-icon-btn" aria-label="アカウント(準備中)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="12" cy="8.5" r="3.3" />
                  <path d="M4.5 20c1.4-3.6 4.3-5.5 7.5-5.5s6.1 1.9 7.5 5.5" stroke-linecap="round" />
                </svg>
              </button>
            </div>
          </div>
        )
      }
      <div class="container site-header-inner">
        <a href="/" class="logo" aria-label="YAMATO OUTDOOR トップページ">
          <img class="logo-light" src="/logo.png" alt="YAMATO OUTDOOR" width="220" height="85" />
          <img class="logo-dark" src="/logo-dark.png" alt="YAMATO OUTDOOR" width="220" height="85" />
        </a>
        <nav class={`site-nav ${isArticleTheme ? 'is-pills' : ''}`} aria-label="カテゴリ">
          <ul>
            {
              categories.map((c) => (
                <li class={isArticleTheme && c.slug === activeCategorySlug ? 'is-active' : ''}>
                  <a href={`/category/${c.slug}/`}>
                    {c.name}
                    {c.status === 'upcoming' && <span class="nav-badge">準備中</span>}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <section class="cta-band">
      <div class="cta-scrim"></div>
      <div class="container cta-inner">
        <p class="hero-eyebrow">YAMATO OUTDOOR</p>
        <h2>次の山行の準備は、<br />できているか。</h2>
        <a class="cta-button" href="/category/mountain-climbing/">登山カテゴリを見る →</a>
      </div>
    </section>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div class="footer-brand">
            <a href="/" class="logo logo-small" aria-label="YAMATO OUTDOOR トップページ">
              <img src="/logo.png" alt="YAMATO OUTDOOR" width="220" height="85" />
            </a>
            <p class="footer-mission">山と生きる。山と挑む。<br />実体験ベースのアウトドアメディア。</p>
          </div>
          <div class="footer-nav-groups">
            <div class="footer-nav-group">
              <h4>Category</h4>
              <ul>
                {
                  categories.map((c) => (
                    <li>
                      <a href={`/category/${c.slug}/`}>{c.name}</a>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="footer-nav-group">
              <h4>Site</h4>
              <ul>
                <li><a href="/">トップ</a></li>
              </ul>
            </div>
          </div>
        </div>
        <img class="footer-skyline" src="/mountain-line.svg" alt="" aria-hidden="true" width="1200" height="120" />
        <div class="footer-bottom">
          <span>&copy; {new Date().getFullYear()} YAMATO OUTDOOR</span>
        </div>
      </div>
    </footer>

    <script>
      const header = document.getElementById('site-header');
      if (header) {
        const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
