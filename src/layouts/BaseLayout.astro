---
import '../styles/global.css';
import { categories } from '../lib/categories';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '山と生きる。山と挑む。実体験ベースのアウトドアメディア。' } = Astro.props;

// Umami Cloudの無料Hobbyプランで計測する。UMAMI_WEBSITE_ID未設定時はスクリプトごと省略する
// (アカウント作成前でもビルド・表示が壊れないようにするため)。
const umamiWebsiteId = import.meta.env.UMAMI_WEBSITE_ID;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {umamiWebsiteId && (
      <script defer src="https://cloud.umami.is/script.js" data-website-id={umamiWebsiteId}></script>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">本文へスキップ</a>
    <header class="site-header">
      <div class="container site-header-inner">
        <a href="/" class="logo" aria-label="YAMATO OUTDOOR トップページ">
          <span class="logo-line">YAMATO</span>
          <span class="logo-line logo-line-sub">OUTDOOR</span>
        </a>
        <nav class="site-nav" aria-label="カテゴリ">
          <ul>
            {
              categories.map((c) => (
                <li>
                  <a href={`/category/${c.slug}/`}>
                    {c.name}
                    {c.status === 'upcoming' && <span class="nav-badge">準備中</span>}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer-inner">
        <div>
          <a href="/" class="logo logo-small" aria-label="YAMATO OUTDOOR トップページ">
            <span class="logo-line">YAMATO</span>
            <span class="logo-line logo-line-sub">OUTDOOR</span>
          </a>
          <p class="footer-mission">山と生きる。山と挑む。</p>
        </div>
        <nav class="footer-nav" aria-label="カテゴリ">
          <ul>
            {
              categories.map((c) => (
                <li>
                  <a href={`/category/${c.slug}/`}>{c.name}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="copyright">&copy; {new Date().getFullYear()} YAMATO OUTDOOR</p>
      </div>
    </footer>
  </body>
</html>
