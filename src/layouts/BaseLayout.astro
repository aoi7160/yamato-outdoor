---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '山と生きる。山と挑む。実体験ベースのアウトドアメディア。' } = Astro.props;

// Umami Cloudの無料Hobbyプランで計測する。UMAMI_WEBSITE_ID未設定時はスクリプトごと省略する
// (アカウント作成前でもビルド・表示が壊れないようにするため)。
const umamiWebsiteId = import.meta.env.UMAMI_WEBSITE_ID;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {umamiWebsiteId && (
      <script defer src="https://cloud.umami.is/script.js" data-website-id={umamiWebsiteId}></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="site-title">YAMATO OUTDOOR</a>
        <span class="site-tagline">山と生きる。山と挑む。</span>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} YAMATO OUTDOOR</p>
      </div>
    </footer>
  </body>
</html>
