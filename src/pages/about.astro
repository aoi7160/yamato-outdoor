---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GENRES, genrePath } from '../lib/taxonomy';

// 説明的な文章は画面に置かず、検索エンジン向けの構造化データとmeta descriptionに寄せる。
const seoDescription =
  'YAMATO OUTDOORは、関西の山を軸に、実際に使った装備とルートだけを記録するアウトドアメディアです。実測値と複数回の使用にもとづく装備レビュー、山行記録、道具選びのハウツーを掲載しています。';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://yamato-outdoor.com';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'YAMATO OUTDOORについて',
    description: seoDescription,
    url: `${siteUrl}/about`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'YAMATO OUTDOOR',
    url: siteUrl,
    logo: `${siteUrl}/logo.svg`,
    description: seoDescription,
    founder: { '@type': 'Person', name: '濵地 蒼麗', jobTitle: 'Founder / Editor' },
    areaServed: '日本',
    knowsAbout: ['登山', '登山装備', 'アウトドアギア', '関西の山', 'キャンプ', '釣り'],
  },
];

// 行ごとに下からせり上がるので、見出し系のコピーは1行=1要素で持つ。
// 改行位置を変えたいときは、この配列の要素を足し引きする。
const heroTitleLines = ['知っているほど、', '荷物は軽い。'];
const heroLead = '試した数だけ、迷いは減っていく。';

const introLines = [
  '後悔するのは、いつも荷物のことだ。',
  '軽すぎて震えた日も、',
  '重すぎて足が止まった日もある。',
];
const introSub = 'だから、書く前にまず持っていく。';

const missionLines = ['次の休みが、', '待ち遠しくなるように。'];

const principles = [
  {
    num: '01',
    title: '買わない理由まで書く',
    body: '欠点のないレビューは、広告と同じです。合わなかった点、返品した理由、二度と使っていない道具のことも、同じ分量で書きます。',
    image: '/media/category/mountain-climbing.webp',
    alt: '霧に包まれた稜線を歩く登山者たち',
  },
  {
    num: '02',
    title: '数字は自分で量る',
    body: 'カタログの重量と、実際にザックに入る重量は一致しません。掲載する重さ・サイズは、手元の実測値です。違えば違うと書きます。',
    image: '/media/category/camp.webp',
    alt: '星空の下に張られたテント',
  },
  {
    num: '03',
    title: '一度で判断しない',
    body: '晴れの日だけで分かることは、ほとんどありません。雨の日、風の日、汗をかいた登り返し。条件を変えて使ってから書きます。',
    image: '/media/category/fishing.webp',
    alt: '水辺に置かれた釣り椅子と竿',
  },
];

const facts = [
  { label: '山に入る頻度', value: '月1〜2回' },
  { label: '主なフィールド', value: '関西の山' },
  { label: '装備レビューの条件', value: '3回以上' },
  { label: '広告での評価変更', value: 'なし' },
];

const steps = [
  { num: '01', title: '使う', body: '実際の山行に持ち込む。天候と季節を変えて、最低3回。' },
  { num: '02', title: '量る', body: '重量、サイズ、電池の持ち。数値は手元で測り直す。' },
  { num: '03', title: '書く', body: '良かった点と、合わなかった点。判断の分かれ目まで書く。' },
  { num: '04', title: '直す', body: '使い続けて印象が変わったら、記事を更新する。書きっぱなしにしない。' },
];

const readers = [
  '働きながら、月に1〜2回のペースで山に行く人',
  '一度、道具選びで失敗したことがある人',
  '六甲や金剛山など、関西の山をよく歩く人',
  'カタログの数字より、使った人の言葉で決めたい人',
];
---

<BaseLayout title="ABOUT | YAMATO OUTDOOR" description={seoDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <!-- 登場アニメーションを有効にする印。JSが動かない/視差効果を減らす設定のときは
         付かないので、その場合は最初から表示された状態のまま読める。 -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ready');
      }
    </script>
  </Fragment>

  <!-- カバー。写真ではなく、左にコピー・右に等高線と霧の粒を置いて、
       読み込み直後に一度だけ動かす(以降は静止) -->
  <section class="about-hero">
    <div class="shell about-hero__inner">
      <div class="about-hero__copy" data-anim="lines">
        <p class="about-hero__eyebrow line-mask" style="--d: 0s"><span>About</span></p>
        <h1 class="about-hero__title">
          {heroTitleLines.map((line, i) => (
            <span class="line-mask" style={`--d: ${0.12 + i * 0.12}s`}><span>{line}</span></span>
          ))}
        </h1>
        <p class="about-hero__lead line-mask" style={`--d: ${0.12 + heroTitleLines.length * 0.12}s`}>
          <span>{heroLead}</span>
        </p>
        <a class="pill about-hero__cta" href="#principles">
          書くときに守っていること
          <span class="pill__arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="about-hero__figure" data-anim="figure" aria-hidden="true">
        <svg viewBox="0 0 520 520" role="presentation" focusable="false">
