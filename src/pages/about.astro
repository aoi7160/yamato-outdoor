---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GENRES, genrePath } from '../lib/taxonomy';

const seoDescription =
  'YAMATO OUTDOORは、関西の山を軸に、実際に持ち込んだ装備と歩いたルートだけを記録するアウトドアメディアです。挑戦のベースキャンプとして、装備レビュー、山行記録、道具選びのハウツーを掲載しています。';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://yamato-outdoor.com';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'YAMATO OUTDOORについて',
    description: seoDescription,
    url: `${siteUrl}/about`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'YAMATO OUTDOOR',
    url: siteUrl,
    logo: `${siteUrl}/logo.svg`,
    description: seoDescription,
    slogan: '挑戦の、ベースキャンプになる。',
    founder: { '@type': 'Person', name: '濵地 蒼麗', jobTitle: 'Founder / Editor' },
    areaServed: '日本',
    knowsAbout: ['登山', '登山装備', 'アウトドアギア', '関西の山', 'キャンプ', '釣り'],
  },
];

// 大きいコピーは行ごとに下からせり上げるので、1行=1要素で持つ。
// 改行位置を変えたいときは、配列の要素を足し引きする。
const statement = '次の一歩は、ここで決まる。';

const missionCopy = ['挑戦の、', 'ベースキャンプになる。'];
const visionCopy = ['終わりなき成長に、', '挑む輪を広げていく。'];
const visionNote = [
  '到達点を決めた時点で、成長は止まる。',
  '終わりがないから、人はどこまでも行ける。',
  '誰が、いつ始めてもいい。',
  'その輪を、社会に広げていく。',
];

const values = [
  { num: '01', name: '名実一体', body: '誰に聞いても一流と認められる自分たちでいる。' },
  { num: '02', name: '大胆自責', body: '責任を取れる範囲が、挑戦の大きさを決める。' },
  { num: '03', name: '敢為邁往', body: '分かれ道では、険しい方へ。楽に着いた場所に、見たい景色はない。' },
  { num: '04', name: '格物致知', body: '誰かの地図を、そのまま歩かない。人が動く理由は、自分で読み解く。' },
  { num: '05', name: '好学不倦', body: '考えるのをやめた瞬間、毎日はただの繰り返しになる。' },
];

const readers = [
  '働きながら、月に1〜2回のペースで山に行く人',
  '一度、道具選びで失敗したことがある人',
  'カタログの数字より、使った人の言葉で決めたい人',
  '誰かのおすすめではなく、自分の基準で決めたい人',
];

const editorBody = [
  '会社勤めの傍ら、月1〜2回のペースで山に入る。六甲、金剛山、大山など関西の山を中心に、スタイルを問わず足繁く通う。',
  'カタログスペックに頼らず、自らの体験と考えを基に記事を監修。',
  '納得できる道具を追い求めた結果、人の挑戦が始まる場所をつくるべく、アウトドアブランド「YAMATO OUTDOOR」の立ち上げに至る。',
];

const mediaData = [
  { label: '媒体名', value: 'YAMATO OUTDOOR' },
  { label: '領域', value: '登山 / 釣り / キャンプ' },
  { label: '扱う内容', value: '装備レビュー、山行記録、道具選びのハウツー' },
  { label: '運営', value: '濵地 蒼麗' },
];
---

<BaseLayout title="ABOUT | YAMATO OUTDOOR" description={seoDescription} plain>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <!-- 登場アニメーションを有効にする印。JSが動かない/視差効果を減らす設定のときは
         付かないので、その場合は最初から表示された状態のまま読める。 -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ready');
      }
    </script>
  </Fragment>

  <div class="about-page">
    <div class="dots-layer" aria-hidden="true"></div>

    <!-- カバー。タイトル・写真3枚・Statementを同じ正方グリッドに載せる -->
    <div class="about-grid">
      <div class="about-title-area" data-anim="lines">
        <h1 class="about-title">
          <span class="line-mask"><span>About</span></span>
          <span class="line-mask" style="--d: 0.12s"><span>YAMATO OUTDOOR</span></span>
        </h1>
      </div>

      <div class="about-visual visual-01" data-anim="up">
        <span class="v-inner">
          <img src="/media/hero/01.webp" alt="霧の稜線" width="1600" height="900" fetchpriority="high" decoding="async" />
        </span>
      </div>
      <div class="about-visual visual-02" data-anim="up">
        <span class="v-inner">
          <img src="/media/category/mountain-climbing.webp" alt="霧に包まれた稜線を歩く登山者たち" width="1200" height="900" loading="lazy" decoding="async" />
        </span>
      </div>
      <div class="about-visual visual-03" data-anim="up">
        <span class="v-inner">
          <img src="/media/category/camp.webp" alt="星空の下に張られたテント" width="1200" height="900" loading="lazy" decoding="async" />
        </span>
      </div>

      <div class="statement-area" data-anim="lines">
        <h2 class="statement">
          <span class="statement__label">Statement</span>
          <span class="line-mask" style="--d: 0.2s"><span>{statement}</span></span>
        </h2>
      </div>
    </div>

    <!-- Mission -->
    <section class="about-section">
      <div class="about-section__title"><h2>Mission</h2></div>
      <div class="about-grid about-grid--first">
        <div class="area-text mission-text js-auto-height" data-anim="lines">
          <p class="big-copy">
            {missionCopy.map((line, i) => (
              <span class="line-mask" style={`--d: ${i * 0.12}s`}><span>{line}</span></span>
            ))}
          </p>
        </div>
      </div>
    </section>

    <!-- Vision -->
    <section class="about-section">
      <div class="about-section__title"><h2>Vision</h2></div>
      <div class="about-grid about-grid--first">
        <div class="area-text vision-text js-auto-height" data-anim="lines">
          <p class="big-copy">
            {visionCopy.map((line, i) => (
              <span class="line-mask" style={`--d: ${i * 0.12}s`}><span>{line}</span></span>
            ))}
          </p>
          <p class="note-copy">
            {visionNote.map((line) => (
              <>{line}<br /></>
            ))}
          </p>
        </div>
      </div>
    </section>

    <!-- Value -->
    <section class="about-section">
      <div class="about-section__title"><h2>Value</h2></div>
      <div class="about-grid about-grid--first">
        <div class="about-visual value-visual" data-anim="up">
          <span class="v-inner">
            <img src="/media/category/fishing.webp" alt="水辺に置かれた釣り椅子と竿" width="1200" height="900" loading="lazy" decoding="async" />
          </span>
        </div>
        <div class="value-list js-auto-height">
          <ol>
            {values.map((v, i) => (
              <li data-anim="up" style={`--d: ${i * 0.08}s`}>
                <span class="val-num">{v.num}</span>
                <span>
                  <span class="val-name">{v.name}</span>
                  <span class="val-body">{v.body}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Readers -->
    <section class="about-section">
      <div class="about-section__title"><h2>For Readers</h2></div>
      <div class="about-grid about-grid--first">
        <div class="readers-list readers-list--wide js-auto-height">
          <ul>
            {readers.map((r, i) => (
              <li data-anim="up" style={`--d: ${i * 0.08}s`}>{r}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Editor -->
    <section class="about-section">
      <div class="about-section__title"><h2>Editor</h2></div>
      <div class="about-grid about-grid--first">
        <div class="editor-head js-auto-height" data-anim="up">
          <p class="editor-role">Founder / Editor</p>
          <p class="editor-name">濵地 蒼麗</p>
        </div>
        <div class="area-text editor-text js-auto-height" data-anim="up" style="--d: 0.12s">
          {editorBody.map((t) => <p>{t}</p>)}
        </div>
      </div>
    </section>

    <!-- Media data -->
    <section class="about-section">
      <div class="about-section__title"><h2>Media data</h2></div>
      <div class="about-grid about-grid--first">
        <div class="media-list js-auto-height" data-anim="up">
          <dl>
            {mediaData.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- Related -->
    <div class="about-grid">
      <div class="related-title" data-anim="up"><h2>Related</h2></div>
      <div class="about-visual related-visual" data-anim="up">
        <span class="v-inner">
          <img src="/media/hero/01.webp" alt="霧の稜線" width="1600" height="900" loading="lazy" decoding="async" />
        </span>
      </div>
      <div class="related-links" data-anim="up" style="--d: 0.12s">
        {GENRES.map((g) => (
          <a href={genrePath(g.slug)}>
            {g.name} ↗
            {g.status === 'upcoming' && <span class="badge">準備中</span>}
          </a>
        ))}
      </div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const page = document.querySelector('.about-page');
      if (!page) return;

      // 縦スクロールバーの幅を変数に入れる。100vwのままだと横にあふれる
      const setScrollbarWidth = () => {
        const sbw = window.innerWidth - document.documentElement.clientWidth;
        document.documentElement.style.setProperty('--sbw', `${sbw}px`);
      };

      // テキストの枠は、中身の高さから必要な行数を計算してグリッドに吸着させる
      const autoHeight = () => {
        const grid = page.querySelector('.about-grid');
        if (!grid) return;
        const cell = grid.getBoundingClientRect().width / 5;
        if (!cell) return;
        page.querySelectorAll('.js-auto-height').forEach((el) => {
          el.style.gridRowEnd = 'auto';
          const rows = Math.ceil(el.offsetHeight / cell);
          el.style.gridRowEnd = `span ${Math.max(1, rows)}`;
        });
      };

      const layout = () => {
        setScrollbarWidth();
        autoHeight();
      };

      layout();
      window.addEventListener('load', layout);
      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(layout, 200);
      });

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;

      // 画面に入った要素に is-in を付けるだけ。出し終わったら監視を外す
      const targets = page.querySelectorAll('[data-anim]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0 },
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-in'));
      }

      // 写真の視差とStatementの消え方。スクロールのたびにrAFで1回だけ計算する
      const images = [...page.querySelectorAll('.v-inner img')];
      const statementArea = page.querySelector('.statement-area');
      const firstTitle = page.querySelector('.about-section__title');
      let ticking = false;

      const update = () => {
        ticking = false;
        const vh = window.innerHeight;

        images.forEach((img) => {
          const box = img.parentElement.getBoundingClientRect();
          if (box.bottom < 0 || box.top > vh) return;
          const progress = (vh - box.top) / (vh + box.height);
          img.style.transform = `translate3d(0, ${((progress * 2 - 1) * -6).toFixed(2)}%, 0)`;
        });

        if (statementArea && firstTitle) {
          const top = firstTitle.getBoundingClientRect().top;
          const fade = Math.min(1, Math.max(0, (top - vh * 0.5) / (vh * 0.3)));
          statementArea.style.opacity = String(fade);
        }
      };

      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        },
        { passive: true },
      );
      update();
    })();
  </script>
</BaseLayout>
