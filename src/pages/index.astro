---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles } from '../lib/microcms';
import { formatDate } from '../lib/article';
import { GENRES, articlePath, genrePath } from '../lib/taxonomy';

const { contents: articles } = await getArticles({ orders: '-publishedAt', limit: 6 });

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://yamato-outdoor.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'YAMATO OUTDORのジャンル',
  itemListElement: GENRES.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.name,
    description: g.description,
    url: `${siteUrl}${genrePath(g.slug)}`,
  })),
};
---

<BaseLayout title="YAMATO OUTDOOR | 山と生きる。山と挑む。" grainDrift={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </Fragment>

  <section class="cover cover--video">
    <video
      class="cover__image"
      poster="/media/hero/01.webp"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      width="1600"
      height="900"
      aria-hidden="true"
    >
      <source src="/media/hero/01-mist.mp4" type="video/mp4" />
    </video>
    <div class="cover__scrim"></div>
    <div class="shell cover__inner">
      <p class="cover__eyebrow">YAMATO OUTDOOR</p>
      <h1>山と生きる。<br />山と挑む。</h1>
      <p class="cover__lead">実体験ベースの装備検証・レビューを届ける<br />アウトドアメディア。</p>
    </div>
    <span class="cover__cue" aria-hidden="true">SCROLL</span>
  </section>

  <!-- 私たちについて。ジャンル選択の前に、メディアの立ち位置を一度だけ挟む。
       見出しはAboutページのStatementと同じ一行にして、下のジャンル選択(=次の一歩)
       に自然につながるようにしている。 -->
  <section class="shell about-intro">
    <p class="about-intro__eyebrow">About YAMATO OUTDOOR</p>
    <h2>次の一歩は、ここで決まる。</h2>
    <p>
      実際に持ち込んだ装備と、歩いたルートだけを記録しています。
    </p>
    <a class="about-intro__link" href="/about">私たちについて →</a>
  </section>

  <!-- ジャンル選択をスクロール連動で見せる。右のパネルをスクロールで通過すると
       左の写真がクロスフェードする(IntersectionObserverでの切り替え+CSSトランジションのみ。
       .scenery__driftのような常時rAFアニメーションではないので、スクロール時だけの
       一過性のコストで済み、CLAUDE.mdの「背景アニメーション4層まで」の制約の対象外)。 -->
  <section class="shell story-section">
    <div class="section-head">
      <h2>Explore</h2>
      <span class="count">ジャンルから探す</span>
    </div>

    <div class="story" id="story">
      <div class="story-visual">
        <div class="story-visual-inner">
          {GENRES.map((g, i) => (
            <img
              class:list={['story-image', { 'is-active': i === 0 }]}
              data-story-image={i}
              src={g.image}
              alt={g.imageAlt}
              width={g.imageSize.w}
              height={g.imageSize.h}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              style={`object-position:${g.coverPosition}`}
            />
          ))}
          <span class="story-index-badge" id="story-index-badge">
            01 / {String(GENRES.length).padStart(2, '0')}
          </span>
        </div>
      </div>

      <div class="story-panels">
        {GENRES.map((g, i) => (
          <a
            href={genrePath(g.slug)}
            class:list={['story-panel', { 'is-active': i === 0 }]}
            data-story-panel={i}
          >
            <span class="story-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>
              {g.name}
              {g.status === 'upcoming' && <span class="badge">準備中</span>}
            </h3>
            <p>{g.tagline}</p>
            <span class="story-link">詳しく見る →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const panels = document.querySelectorAll('[data-story-panel]');
      const images = document.querySelectorAll('[data-story-image]');
      const badge = document.getElementById('story-index-badge');
      const total = panels.length;
      if (!panels.length || !images.length) return;

      const activate = (idx) => {
        images.forEach((img, i) => img.classList.toggle('is-active', i === idx));
        panels.forEach((p, i) => p.classList.toggle('is-active', i === idx));
        if (badge) badge.textContent = `${String(idx + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      };

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) activate(Number(entry.target.dataset.storyPanel));
          });
        },
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
      );
      panels.forEach((p) => io.observe(p));
    })();
  </script>

  <section class="shell">
    <div class="section-head">
      <h2>Latest</h2>
      <span class="count">{String(articles.length).padStart(2, '0')} articles</span>
    </div>
    {articles.length === 0 ? (
      <p style="color: var(--ink-faint); padding: 2.5rem 0 4rem;">
        記事を準備中です。microCMSで記事を公開するとここに並びます。
      </p>
    ) : (
      <ul class="article-list">
        {articles.map((article, i) => (
          <li>
            <a class="article-card" href={articlePath(article)}>
              <span class="article-card__index">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <span class="card-meta">
                  {article.category?.name ?? 'Journal'} — {formatDate(article.publishedAt)}
                </span>
                <h2>{article.title}</h2>
                <p class="description">{article.description}</p>
              </span>
              <span class="article-card__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
