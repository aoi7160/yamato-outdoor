---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles } from '../lib/microcms';
import { categories } from '../lib/categories';

const { contents: articles } = await getArticles({ orders: '-publishedAt', limit: 20 });

// public/media/hero/01.webp 〜 05.webp に対応。画像を追加したら番号をここにも足す
// (Cloudflare WorkersランタイムはNode fsが使えないので、存在チェックはビルド時に手動で揃える)。
const heroSlides = ['01'];

// public/media/category/<slug>.webp の縦横比(表示サイズはCSSのobject-fit:coverで揃える)。
const categoryImageSize: Record<string, { w: number; h: number }> = {
  'mountain-climbing': { w: 1500, h: 2000 },
  fishing: { w: 1125, h: 2000 },
  camp: { w: 1459, h: 2000 },
};

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://yamato-outdoor.com';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'YAMATO OUTDOORのカテゴリ',
    itemListElement: categories.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      description: c.description,
      url: `${siteUrl}/category/${c.slug}/`,
    })),
  },
];
---

<BaseLayout title="YAMATO OUTDOOR | 山と生きる。山と挑む。" jsonLd={jsonLd}>
  <section class="hero" id="hero">
    {
      heroSlides.map((slide, i) => (
        <div class:list={['hero-bg-layer', { 'is-active': i === 0 }]} data-hero-layer style={`background-image:url(/media/hero/${slide}.webp)`} />
      ))
    }
    <div class="hero-scrim"></div>
    <div class="container hero-inner">
      <p class="hero-eyebrow">YAMATO OUTDOOR</p>
      <h1>山と生きる。山と挑む。</h1>
      <p class="hero-lead">実体験ベースの装備検証・レビューを届ける<br />アウトドアメディア。</p>
    </div>
    <div class="hero-scroll-cue">SCROLL</div>
  </section>

  <section class="container story-section">
    <h2 class="section-heading">カテゴリから探す</h2>
    <div class="story" id="story">
      <div class="story-visual">
        <div class="story-visual-inner">
          {
            categories.map((c, i) => (
              <img
                class:list={['story-image', { 'is-active': i === 0 }]}
                data-story-image={i}
                src={`/media/category/${c.slug}.webp`}
                alt={c.imageAlt}
                width={categoryImageSize[c.slug].w}
                height={categoryImageSize[c.slug].h}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))
          }
          <span class="story-index-badge" id="story-index-badge">01 / {String(categories.length).padStart(2, '0')}</span>
        </div>
      </div>
      <div class="story-panels">
        {
          categories.map((c, i) => (
            <a
              href={`/category/${c.slug}/`}
              class:list={['story-panel', { 'is-active': i === 0 }]}
              data-story-panel={i}
            >
              <span class="story-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>
                {c.name}
                {c.status === 'upcoming' && <span class="nav-badge">準備中</span>}
              </h3>
              <p>{c.tagline}</p>
              <span class="story-link">詳しく見る →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container article-section">
    <h2 class="section-heading">新着記事</h2>
    {
      articles.length === 0 ? (
        <p class="empty-state">
          記事を準備中です。microCMSで記事を公開するとここに一覧表示されます。
        </p>
      ) : (
        <ul class="article-list">
          {articles.map((article) => (
            <li>
              <a class="article-card" href={`/articles/${article.slug}/`}>
                {article.category && <span class="category">{article.category.name}</span>}
                <h3>{article.title}</h3>
                <p class="description">{article.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<script>
  const heroLayers = document.querySelectorAll<HTMLElement>('[data-hero-layer]');
  if (heroLayers.length > 1) {
    let heroIndex = 0;
    setInterval(() => {
      heroLayers[heroIndex].classList.remove('is-active');
      heroIndex = (heroIndex + 1) % heroLayers.length;
      heroLayers[heroIndex].classList.add('is-active');
    }, 4500);
  }

  const storyPanels = document.querySelectorAll<HTMLElement>('[data-story-panel]');
  const storyImages = document.querySelectorAll<HTMLElement>('[data-story-image]');
  const storyBadge = document.getElementById('story-index-badge');
  const total = storyPanels.length;

  if (storyPanels.length && storyImages.length) {
    const activate = (idx: number) => {
      storyImages.forEach((img, i) => img.classList.toggle('is-active', i === idx));
      storyPanels.forEach((p, i) => p.classList.toggle('is-active', i === idx));
      if (storyBadge) {
        storyBadge.textContent = `${String(idx + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = Number((entry.target as HTMLElement).dataset.storyPanel);
            activate(idx);
          }
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );

    storyPanels.forEach((p) => io.observe(p));
  }
</script>
