---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles } from '../lib/microcms';
import { formatDate } from '../lib/article';

const { contents: articles } = await getArticles({ orders: '-publishedAt', limit: 20 });

// microCMS未接続でも一覧の見え方が確認できるように、見本記事を1本だけ差し込む
const fallback = [
  {
    slug: 'night-hike-basics',
    title: '夜明け前に歩き出す。ナイトハイクで山頂に立つための装備と歩き方',
    description:
      '暗いうちに登り始めて、稜線で朝を迎える。出発時刻の逆算からヘッドランプ選び、汗の管理、山頂での待ち方、下山までを、実際の失敗をたどりながら順にまとめました。',
    category: { name: 'How to' },
    publishedAt: '2026-08-07T00:00:00.000Z',
  },
];

const items = articles.length > 0 ? articles : fallback;
---

<BaseLayout title="YAMATO OUTDOOR | 山と生きる。山と挑む。">
  <section class="hero">
    <div class="shell">
      <p class="hero__eyebrow">Field notes from the ridge</p>
      <h1>山と生きる。<br />山と挑む。</h1>
      <p>準備に、妥協はない。実際に担いで、濡らして、凍らせた装備だけを書く。</p>
    </div>
  </section>

  <section class="shell">
    <div class="section-head">
      <h2>Latest</h2>
      <span class="count">{String(items.length).padStart(2, '0')} articles</span>
    </div>
    <ul class="article-list">
      {items.map((article, i) => (
        <li>
          <a class="article-card" href={`/articles/${article.slug}/`}>
            <span class="article-card__index">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="card-meta">
                {article.category?.name ?? 'Journal'} — {formatDate(article.publishedAt)}
              </span>
              <h2>{article.title}</h2>
              <p class="description">{article.description}</p>
            </span>
            <span class="article-card__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
