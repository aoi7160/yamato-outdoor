---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles } from '../lib/microcms';

const { contents: articles } = await getArticles({ orders: '-publishedAt', limit: 20 });
---

<BaseLayout title="YAMATO OUTDOOR | 山と生きる。山と挑む。">
  <section class="hero">
    <div class="container">
      <h1>山と生きる。山と挑む。</h1>
      <p>準備に、妥協はない。実体験ベースの装備検証・レビューを届けるアウトドアメディア。</p>
    </div>
  </section>

  <section class="container">
    {
      articles.length === 0 ? (
        <p style="color: var(--color-text-muted); padding: 3rem 0;">
          記事を準備中です。microCMSで記事を公開するとここに一覧表示されます。
        </p>
      ) : (
        <ul class="article-list">
          {articles.map((article) => (
            <li>
              <a class="article-card" href={`/articles/${article.slug}/`}>
                {article.category && <span class="category">{article.category.name}</span>}
                <h2>{article.title}</h2>
                <p class="description">{article.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
