---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getArticles, getArticleBySlug } from '../../lib/microcms';
import { normalizeTags } from '../../lib/article';

export async function getStaticPaths() {
  const res = await getArticles({ limit: 100, fields: ['id', 'slug', 'title', 'category', 'publishedAt'] });
  return res.contents.map((a) => ({
    params: { slug: a.slug },
    props: { siblings: res.contents.filter((b) => b.slug !== a.slug) },
  }));
}

const { slug } = Astro.params;
const { siblings = [] } = Astro.props;
const article = await getArticleBySlug(slug!);

if (!article) {
  return Astro.redirect('/404');
}

// 関連記事は同カテゴリを優先して3本。足りなければ新着で埋める。
const related = siblings
  .sort((a, b) => {
    const same = (x: typeof a) => (x.category?.id && x.category.id === article.category?.id ? 0 : 1);
    return same(a) - same(b);
  })
  .slice(0, 3)
  .map((a) => ({
    title: a.title,
    href: `/articles/${a.slug}`,
    meta: a.category?.name,
  }));
---

<ArticleLayout
  title={article.title}
  description={article.description}
  content={article.content}
  categoryName={article.category?.name}
  categorySlug={article.category?.slug}
  publishedAt={article.publishedAt}
  revisedAt={article.revisedAt}
  thumbnailUrl={article.thumbnail?.url}
  tags={normalizeTags(article.tags)}
  related={related}
/>
