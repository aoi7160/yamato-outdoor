---
// microCMSの画面プレビュー専用ページ。
// 下書きコンテンツを都度取得して表示するため、このページのみリクエスト時にレンダリングする。
export const prerender = false;

import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getArticleDraft } from '../../lib/microcms';

const { contentId } = Astro.params;
const draftKey = Astro.url.searchParams.get('draftKey');

if (!contentId || !draftKey) {
  return new Response('contentId または draftKey が指定されていません。', { status: 400 });
}

const article = await getArticleDraft(contentId, draftKey);

if (!article) {
  return new Response('下書きコンテンツが見つかりませんでした。', { status: 404 });
}
---

<ArticleLayout
  title={`[プレビュー] ${article.title}`}
  description={article.description}
  content={article.content}
  categoryName={article.category?.name}
  publishedAt={article.publishedAt}
  revisedAt={article.revisedAt}
  thumbnailUrl={article.thumbnail?.url}
  tags={article.tags ?? []}
/>
