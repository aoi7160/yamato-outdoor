---
// カテゴリ別の記事一覧。ヘッダーの Gear / Route などはここに着地する。
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles, getCategories } from '../../lib/microcms';
import { formatDate } from '../../lib/article';

export async function getStaticPaths() {
  // 記事がまだ無くても、ヘッダーのリンク先が404にならないよう常に用意しておくカテゴリ。
  // getStaticPathsはフロントマターの本体より先に実行されるので、この中で定義する。
  const FALLBACK: Record<string, string> = { gear: 'Gear', route: 'Route', 'how-to': 'How to' };
  const categories = await getCategories();

  const paths = categories
    .filter((c) => c.slug)
    // microCMSの参照フィールドはコンテンツIDでしか絞り込めないため、
    // slugと一緒にidも渡しておく(slugで filters を書くと0件になる)
    .map((c) => ({ params: { slug: c.slug }, props: { name: c.name, id: c.id } }));

  const known = new Set(paths.map((p) => p.params.slug));
  Object.entries(FALLBACK).forEach(([slug, name]) => {
    if (!known.has(slug)) paths.push({ params: { slug }, props: { name, id: '' } });
  });

  return paths;
}

const { slug } = Astro.params;
const { name, id } = Astro.props;

const { contents: articles } = id
  ? await getArticles({ filters: `category[equals]${id}`, orders: '-publishedAt', limit: 50 })
  : { contents: [] };

const labels: Record<string, string> = {
  gear: 'テント・ウェア・ギアの実地レビューと検証。買う前に知りたかったことを書く。',
  route: '実際に歩いたルートの記録。コースタイム、水場、エスケープの判断。',
  'how-to': '技術と考え方。読図、レイヤリング、計画の立て方。',
};
---

<BaseLayout title={`${name} | YAMATO OUTDOOR`} description={labels[slug!] ?? `${name}の記事一覧`}>
  <section class="hero">
    <div class="shell">
      <p class="hero__eyebrow">Category</p>
      <h1>{name}</h1>
      <p>{labels[slug!] ?? ''}</p>
    </div>
  </section>

  <section class="shell">
    <div class="section-head">
      <h2>Articles</h2>
      <span class="count">{String(articles.length).padStart(2, '0')} articles</span>
    </div>
    {articles.length === 0 ? (
      <p style="color: var(--ink-faint); padding: 2.5rem 0 4rem;">
        このカテゴリの記事は準備中です。
      </p>
    ) : (
      <ul class="article-list">
        {articles.map((article, i) => (
          <li>
            <a class="article-card" href={`/articles/${article.slug}/`}>
              <span class="article-card__index">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <span class="card-meta">{formatDate(article.publishedAt)}</span>
                <h2>{article.title}</h2>
                <p class="description">{article.description}</p>
              </span>
              <span class="article-card__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
