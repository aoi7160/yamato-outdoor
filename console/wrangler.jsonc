// Cloudflare Workers で配信するときの設定(手順は SETUP.md)。
// Cloudflareの「Workers」の作成画面で、デプロイコマンドを `cd console && npx wrangler deploy` にすると、これが使われる。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflareの画面で付けたプロジェクト名と同じにする(違うとビルドが止まる)
  "name": "yamato-basecamp",
  "main": "server/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /api/* だけWorkerを通し、ほかのページは静的ファイルをそのまま返す
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // 環境変数はCloudflareの画面(設定 → 変数とシークレット)で入れる。デプロイで消さないようにする
  "keep_vars": true,
  // 外部APIの結果を置いておくキャッシュ(Workers KV・無料枠)。workers.dev ではCloudflareの通常のキャッシュが効かないため。
  // id を書かなくても、初回のデプロイで wrangler が自動で作る(自動プロビジョニング)
  "kv_namespaces": [{ "binding": "BASECAMP_CACHE" }],
  "observability": { "enabled": true }
}
