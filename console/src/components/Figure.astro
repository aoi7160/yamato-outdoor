---
/**
 * 部のメンバー(役割)のアバター。
 *
 * 顔は描かず、夕暮れの稜線に立つ人のような「シルエット＋本部色のリムライト」で描く。
 * 人ごとの違いは、髪・帽子の輪郭と、細い線で描く小物(メガネ・ヘッドセットなど)で出す。
 *
 *   社長室・経営企画 … ダウンベストの襟とキルト。整えた髪、四角いメガネ
 *   プロダクト・コンテンツ … フーディー。ニット帽・丸メガネ・首にヘッドホン・耳にペン
 *   ビジネス・レベニュー … シェルジャケットの立ち襟。キャップ・ヘッドセット
 *   コーポレート … ジャケットの襟。ブロウ型のメガネ・社員証
 *
 * 右下の点は状態(緑=待機 / 琥珀=作業中)。発言中は外周のリングが光る(どちらもCSSで切り替え。opacityと色だけ)。
 * 顔ぶれは部の id とメンバーの番号で決まる(毎回同じ)。
 */
import type { DivisionId } from '../lib/org';

interface Props {
  label: string;
  index: number;
  division: DivisionId;
  /** 顔ぶれを決める種。部の id を渡す */
  seed: string;
}
const { label, index, division, seed } = Astro.props;

type Look = {
  hair: 'short' | 'side' | 'crop' | 'bob' | 'tied';
  glasses?: 'rect' | 'round' | 'brow';
  hat?: 'beanie' | 'cap';
  headset?: boolean;
  headphones?: boolean;
  pen?: boolean;
  badge?: boolean;
};

// 本部ごとの「3人の組み合わせ」。部ごとにずらして使うので、同じ本部でも部によって顔ぶれが変わる
const LOOKS: Record<DivisionId, Look[]> = {
  executive: [{ hair: 'side', glasses: 'rect' }, { hair: 'crop' }, { hair: 'bob', glasses: 'brow' }],
  'product-content': [
    { hair: 'short', hat: 'beanie', glasses: 'round' },
    { hair: 'tied', headphones: true },
    { hair: 'side', glasses: 'rect', pen: true },
  ],
  revenue: [{ hair: 'short', hat: 'cap' }, { hair: 'side', headset: true }, { hair: 'bob', glasses: 'round' }],
  corporate: [
    { hair: 'side', glasses: 'brow', badge: true },
    { hair: 'bob', badge: true },
    { hair: 'crop', glasses: 'rect', badge: true },
  ],
};

// 役割の名前から、それらしい小物を足す
function byRole(look: Look, name: string): Look {
  if (/執筆|リライト/.test(name)) return { ...look, pen: true, glasses: look.glasses ?? 'rect' };
  if (/校閲|編集長|事実確認|法令|監査/.test(name)) return { ...look, glasses: look.glasses ?? 'brow' };
  if (/映像|サムネイル|図解|デザイン/.test(name)) return { ...look, headphones: !look.headset };
  if (/トレンド|案件|リサーチ/.test(name)) return { ...look, headset: !look.headphones && !look.hat };
  return look;
}

const hash = [...seed].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const pick = <T,>(xs: T[], n: number) => xs[n % xs.length];
const look = byRole(pick(LOOKS[division] ?? LOOKS.corporate, index + hash), label);
const uid = `fig-${seed}-${index}`.replace(/[^a-z0-9-]/gi, '');

/* シルエットの部品(塗りと輪郭で同じ形を使う) */
const HEAD = 'M24 12.4 C28.2 12.4 30.9 15.6 30.9 20.4 C30.9 25.4 28 28.6 24 28.6 C20 28.6 17.1 25.4 17.1 20.4 C17.1 15.6 19.8 12.4 24 12.4 Z';
const NECK = 'M21 26 L27 26 L27.6 33.6 L20.4 33.6 Z';
const BODY = 'M4.5 50 C4.5 39 11.5 33 24 33 C36.5 33 43.5 39 43.5 50 Z';
const HAIR: Record<Look['hair'], string> = {
  short: 'M16.8 19.4 C16.4 13.4 19.8 11.4 24 11.4 C28.4 11.4 31.6 13.6 31.2 19.4 C29.6 16.6 27 15.6 24 15.7 C21 15.8 18.4 16.8 16.8 19.4 Z',
  side: 'M16.7 20.2 C15.7 12.8 20 10.6 24.6 10.8 C29.8 11 32.4 14.4 31.3 19.8 C29 16.2 25 15.2 21.4 16.6 C19.3 17.4 17.7 18.7 16.7 20.2 Z',
  crop: 'M17.2 17.6 C17.5 13.4 20.4 12 24 12 C27.6 12 30.5 13.4 30.8 17.6 C28.4 15.8 19.6 15.8 17.2 17.6 Z',
  bob: 'M17 19.6 C17 13.8 20 12 24 12 C28 12 31 13.8 31 19.6 C29 16.6 26.6 15.4 24 15.4 C21.4 15.4 19 16.6 17 19.6 Z',
  tied: 'M17.2 19 C17.2 13.8 20.2 12 24 12 C27.8 12 30.8 13.8 30.8 19 C28.8 16.4 26.4 15.4 24 15.4 C21.6 15.4 19.2 16.4 17.2 19 Z',
};
const BOB_BACK = 'M16 22 C15.2 13.2 19.4 10.8 24 10.8 C28.6 10.8 32.8 13.2 32 22 L32.4 28.6 C30.8 29.6 29.6 28.6 29.8 26.4 L18.2 26.4 C18.4 28.6 17.2 29.6 15.6 28.6 Z';
const BUN = 'M24 7.4 C25.7 7.4 26.9 8.6 26.9 10.2 C26.9 11.8 25.7 13 24 13 C22.3 13 21.1 11.8 21.1 10.2 C21.1 8.6 22.3 7.4 24 7.4 Z';
const BEANIE = 'M16.2 19.2 C16.2 12.2 19.8 9.6 24 9.6 C28.2 9.6 31.8 12.2 31.8 19.2 Z';
const CAP = 'M16.7 18.4 C16.7 12.6 20 10.6 24 10.6 C28 10.6 31.3 12.6 31.3 18.4 Z M23 17.2 L35 17.6 C35.6 18.9 34 19.8 31.8 19.5 L23 19 Z';

const silhouette = [
  look.hair === 'bob' && !look.hat ? BOB_BACK : '',
  BODY,
  NECK,
  HEAD,
  look.hat === 'beanie' ? BEANIE : look.hat === 'cap' ? CAP : HAIR[look.hair],
  look.hair === 'tied' && !look.hat ? BUN : '',
].filter(Boolean);
const hairShape = look.hat ? (look.hat === 'beanie' ? BEANIE : CAP) : HAIR[look.hair];

const line = 'color-mix(in srgb, var(--div) 70%, #ffffff)';
const glass = '#dfe6ec';
---
<div class="fig" data-member={index}>
  <svg viewBox="0 0 48 48" aria-hidden="true">
    <defs>
      <clipPath id={`${uid}-clip`}><circle cx="24" cy="24" r="22"></circle></clipPath>
      <linearGradient id={`${uid}-body`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: color-mix(in srgb, var(--div) 24%, #3a4653)"></stop>
        <stop offset="1" style="stop-color: #0f151b"></stop>
      </linearGradient>
    </defs>

    {/* 台座 */}
    <circle cx="24" cy="24" r="22" fill="#0c1218"></circle>
    <g clip-path={`url(#${uid}-clip)`}>

      {/* リムライト(本部色の輪郭)→ その上に同じ形の塗りを重ねて、外側の輪郭だけを残す */}
      <g style={`stroke: ${line}`} stroke-width="1.7" fill="none" stroke-linejoin="round">
        {silhouette.map((d) => <path d={d}></path>)}
      </g>
      <g fill={`url(#${uid}-body)`}>
        {silhouette.map((d) => <path d={d}></path>)}
      </g>
      {/* 髪・帽子は少し暗く */}
      <path d={hairShape} fill="#080c10" fill-opacity="0.75"></path>
      {look.hair === 'bob' && !look.hat && <path d="M17.2 20 L17.6 26 M30.8 20 L30.4 26" stroke="#080c10" stroke-width="1.6" stroke-opacity="0.6"></path>}
      {look.hair === 'tied' && !look.hat && <path d={BUN} fill="#080c10" fill-opacity="0.75"></path>}
      {look.hat === 'beanie' && <path d="M16 16.8 L32 16.8" style={`stroke: ${line}`} stroke-width="0.6" stroke-opacity="0.6"></path>}

      {/* 服のディテール(細い線) */}
      <g fill="none" style={`stroke: ${line}`} stroke-width="0.6" stroke-opacity="0.55" stroke-linecap="round">
        {division === 'executive' && <path d="M20.6 33.6 L24 38.8 L27.4 33.6 M9 41.4 C14 40.4 18 40.6 21.6 41.8 M26.4 41.8 C30 40.6 34 40.4 39 41.4 M7.4 45.6 C13 44.6 18 44.8 22.4 46 M25.6 46 C30 44.8 35 44.6 40.6 45.6"></path>}
        {division === 'product-content' && <path d="M15.4 36.6 C17.4 32.2 30.6 32.2 32.6 36.6 M21.6 35.4 L21.2 40 M26.4 35.4 L26.8 40 M24 36 L24 50"></path>}
        {division === 'revenue' && <path d="M18.6 32.8 L24 37.4 L29.4 32.8 M24 37.4 L24 50 M30 41.4 L35 41.4"></path>}
        {division === 'corporate' && <path d="M20.6 33.4 L24 41.4 L27.4 33.4 M20.6 33.4 L17.8 38.6 L22 43.6 M27.4 33.4 L30.2 38.6 L26 43.6"></path>}
      </g>

      {/* 小物 */}
      {look.badge && (
        <>
          <path d="M20.6 33.6 L24 40.2 L27.4 33.6" fill="none" style={`stroke: ${line}`} stroke-width="0.5" stroke-opacity="0.7"></path>
          <rect x="21.7" y="40" width="4.6" height="3.4" rx="0.6" fill={glass} fill-opacity="0.85"></rect>
          <rect x="22.5" y="40.9" width="3" height="0.7" rx="0.3" style="fill: var(--div)"></rect>
        </>
      )}
      {look.headphones && (
        <g style={`stroke: ${line}`} fill="none" stroke-linecap="round">
          <path d="M17.8 34 C18.4 38 29.6 38 30.2 34" stroke-width="1"></path>
          <rect x="15.8" y="32.2" width="3" height="4" rx="1.2" stroke-width="0.8" fill="#0c1218"></rect>
          <rect x="29.2" y="32.2" width="3" height="4" rx="1.2" stroke-width="0.8" fill="#0c1218"></rect>
        </g>
      )}
      {look.glasses === 'rect' && (
        <g fill="none" stroke={glass} stroke-width="0.75" stroke-opacity="0.95">
          <rect x="18.4" y="19.6" width="4.9" height="3.1" rx="0.9"></rect>
          <rect x="24.7" y="19.6" width="4.9" height="3.1" rx="0.9"></rect>
          <path d="M23.3 20.8 L24.7 20.8 M18.4 20.6 L17.2 20.2 M29.6 20.6 L30.8 20.2"></path>
        </g>
      )}
      {look.glasses === 'round' && (
        <g fill="none" stroke={glass} stroke-width="0.75" stroke-opacity="0.95">
          <circle cx="20.9" cy="21.2" r="2.2"></circle>
          <circle cx="27.1" cy="21.2" r="2.2"></circle>
          <path d="M23.1 20.9 L24.9 20.9 M18.7 20.8 L17.2 20.2 M29.3 20.8 L30.8 20.2"></path>
        </g>
      )}
      {look.glasses === 'brow' && (
        <g fill="none" stroke={glass} stroke-linecap="round">
          <path d="M18.3 19.8 L23.3 19.8 M24.7 19.8 L29.7 19.8" stroke-width="1.3"></path>
          <path d="M18.4 20 C18.4 23.2 23.2 23.2 23.2 20 M24.8 20 C24.8 23.2 29.6 23.2 29.6 20 M23.3 20.2 L24.7 20.2" stroke-width="0.5" stroke-opacity="0.75"></path>
        </g>
      )}
      {look.headset && (
        <g style={`stroke: ${line}`} fill="none" stroke-linecap="round">
          <path d="M16.6 19.4 C16.6 9 31.4 9 31.4 19.4" stroke-width="0.9"></path>
          <rect x="15" y="18.8" width="2.8" height="4.6" rx="1.1" stroke-width="0.8" fill="#0c1218"></rect>
          <path d="M16.6 23.4 Q18 27 21.6 26.8" stroke-width="0.8"></path>
          <circle cx="21.8" cy="26.8" r="0.8" style="fill: var(--div)" stroke="none"></circle>
        </g>
      )}
      {look.pen && <path d="M30.4 15.6 L33.2 22.2" style={`stroke: ${line}`} stroke-width="1" stroke-linecap="round"></path>}
    </g>

    {/* 外周のリング(常時は淡く。発言中は .fig__halo が光る) */}
    <circle cx="24" cy="24" r="22" fill="none" stroke="#ffffff" stroke-opacity="0.08" stroke-width="1"></circle>
    <circle class="fig__halo" cx="24" cy="24" r="22.6" fill="none" style="stroke: var(--div)" stroke-width="1.6"></circle>
    {/* 状態のランプ */}
    <circle class="fig__led" cx="40.2" cy="40.2" r="3" fill="#4caf6e" stroke="#10161d" stroke-width="1.6"></circle>
  </svg>
  <span class="fig__label">{label}</span>
</div>
