---
/**
 * 部のメンバー(役割)の人形。登山者のシルエットで、ヘルメットのバイザーが本部の色(--div)。
 * 発言中は .is-speaking で後光(opacityのみ)、作業中は .is-working で「…」を出す。
 */
interface Props {
  label: string;
  index: number;
}
const { label, index } = Astro.props;
---
<div class="fig" data-member={index}>
  <span class="fig__dots" aria-hidden="true">…</span>
  <svg viewBox="0 0 40 52" aria-hidden="true">
    <circle class="fig__halo" cx="20" cy="26" r="21" fill="var(--div)" fill-opacity="0.18"></circle>
    <rect x="5" y="25" width="11" height="19" rx="3.5" fill="#2b3540"></rect>
    <path d="M9 52 C9 35 13 28 20 28 C27 28 31 35 31 52 Z" fill="#1c242d"></path>
    <path d="M15 30 L15 46" stroke="var(--div)" stroke-width="1.6" stroke-linecap="round" opacity="0.8"></path>
    <circle cx="20" cy="16" r="9" fill="#1c242d"></circle>
    <path d="M10.6 14.5 A9.6 9.6 0 0 1 29.4 14.5 Z" fill="#2b3540"></path>
    <rect x="13" y="14" width="14" height="4.6" rx="2.3" fill="var(--div)"></rect>
  </svg>
  <span class="fig__label">{label}</span>
</div>
